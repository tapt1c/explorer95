<?xml version="1.0" encoding="UTF-8"?>
<!-- Manage stacking and activation without intercepting Wine's Win shortcuts. -->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <focus>
    <focusNew>yes</focusNew>
    <followMouse>no</followMouse>
  </focus>
  <keyboard />
  <mouse />
</openbox_config>
