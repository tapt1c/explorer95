#include <windows.h>
#include "src/version.h"

1 VERSIONINFO
FILEVERSION EXPLORER95_VERSION_NUMBER
PRODUCTVERSION EXPLORER95_VERSION_NUMBER
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS__WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "FileDescription", "Explorer95\0"
            VALUE "FileVersion", EXPLORER95_VERSION "\0"
            VALUE "InternalName", "Explorer95\0"
            VALUE "OriginalFilename", "explorer95.exe\0"
            VALUE "ProductName", "Explorer95\0"
            VALUE "ProductVersion", EXPLORER95_VERSION "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1252
    END
END

"EXPLORER95" ICON "resources/explorer95.ico"
143 BITMAP "resources/Bitmap143.bmp"
207 BITMAP "resources/welcome.bmp"
208 BITMAP "build/toolbar98-small.bmp"
209 BITMAP "build/toolbar98-large.bmp"
#ifdef _WIN64
201 RCDATA "build/ui64/tray_hook.dll"
205 RCDATA "build/ui64/task_switch_hook.dll"
208 RCDATA "build/ui64/ex95archive.dll"
211 RCDATA "build/ui64/ex95settings.cpl"
#else
201 RCDATA "build/tray_hook.dll"
205 RCDATA "build/task_switch_hook.dll"
208 RCDATA "build/ex95archive.dll"
211 RCDATA "build/ex95settings.cpl"
206 RCDATA "build/native/EX95TS01.VXD"
#endif

202 RCDATA "resources/Explorer95UI.ttf"
203 RCDATA "resources/LiberationSans-LICENSE.txt"
204 RCDATA "resources/Explorer95UI95.ttf"
209 RCDATA "third_party/unarr/COPYING"
